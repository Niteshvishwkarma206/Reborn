rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.level is int && data.level >= 1 &&
             data.currentXp is int && data.currentXp >= 0 &&
             data.currentChallengeDay is int && data.currentChallengeDay >= 1 && data.currentChallengeDay <= 30 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('rankTier' in data) || (data.rankTier is string && data.rankTier.size() <= 50)) &&
             (!('xpToNextLevel' in data) || (data.xpToNextLevel is int && data.xpToNextLevel > 0)) &&
             (!('streakDays' in data) || (data.streakDays is int && data.streakDays >= 0)) &&
             (!('dailyWaterTargetMl' in data) || (data.dailyWaterTargetMl is int && data.dailyWaterTargetMl >= 0)) &&
             (!('dailyStepTarget' in data) || (data.dailyStepTarget is int && data.dailyStepTarget >= 0)) &&
             (!('dailyKmTarget' in data) || (data.dailyKmTarget is number && data.dailyKmTarget >= 0)) &&
             (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidMission(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.day is int && data.day >= 1 && data.day <= 30 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 50 &&
             data.xpReward is int && data.xpReward >= 0 &&
             data.isCompleted is bool &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('completedAt' in data) || data.completedAt is int || data.completedAt == null) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidStride(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.activityType is string && (data.activityType == 'Walking' || data.activityType == 'Running') &&
             data.distanceKm is number && data.distanceKm >= 0 &&
             data.durationMinutes is int && data.durationMinutes >= 0 &&
             data.steps is int && data.steps >= 0 &&
             (!('date' in data) || (data.date is string && data.date.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidWorkout(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.summary is string && data.summary.size() > 0 && data.summary.size() <= 500 &&
             (!('completedAt' in data) || data.completedAt is timestamp);
    }

    function isValidNutrition(data) {
      return data.date is string && data.date.size() <= 50 &&
             data.waterMl is int && data.waterMl >= 0 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidMind(data) {
      return data.date is string && data.date.size() <= 50 &&
             data.mood is string && data.mood.size() <= 50 &&
             data.focusScore is int && data.focusScore >= 1 && data.focusScore <= 10 &&
             data.confidenceScore is int && data.confidenceScore >= 1 && data.confidenceScore <= 10 &&
             (!('meditationMinutes' in data) || (data.meditationMinutes is int && data.meditationMinutes >= 0)) &&
             (!('readingPages' in data) || (data.readingPages is int && data.readingPages >= 0)) &&
             (!('journalText' in data) || (data.journalText is string && data.journalText.size() <= 2000)) &&
             (!('reflectionText' in data) || (data.reflectionText is string && data.reflectionText.size() <= 2000)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // Subcollection: Missions
      match /missions/{missionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(missionId) && isValidMission(incoming());
        allow delete: if isOwner(userId) && isValidId(missionId);
      }

      // Subcollection: Strides
      match /strides/{strideId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(strideId) && isValidStride(incoming());
        allow delete: if isOwner(userId) && isValidId(strideId);
      }

      // Subcollection: Workouts
      match /workouts/{workoutId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(workoutId) && isValidWorkout(incoming());
        allow delete: if isOwner(userId) && isValidId(workoutId);
      }

      // Subcollection: Nutrition
      match /nutrition/{nutritionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(nutritionId) && isValidNutrition(incoming());
        allow delete: if isOwner(userId) && isValidId(nutritionId);
      }

      // Subcollection: Mind Logs
      match /mind/{mindId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(mindId) && isValidMind(incoming());
        allow delete: if isOwner(userId) && isValidId(mindId);
      }
    }
  }
}
